# Reference for the .env that docker-compose.deploy.yml consumes.
#
# On a real deploy this file is GENERATED by CI from the target GitHub Environment's
# secrets + variables and written to $DEPLOY_DIR/.env on the server — do not hand-edit
# the server. This template documents the full key set and which side (secret/variable)
# each lives on. Copy to `.env` only for local/manual runs; the real .env is gitignored.
#
# Keys use ASP.NET Core "__" section nesting. ASPNETCORE_ENVIRONMENT is NOT here — it is
# pinned to Production in docker-compose.deploy.yml. DEPLOY_HOST/USER/SSH_KEY/DEPLOY_DIR
# live only in GitHub (deploy plumbing) and are never written into this file.

# ---- Secrets (GitHub Environment secrets) ----
# Password inside the connection string must match MSSQL_SA_PASSWORD below.
ConnectionStrings__DefaultConnection=Server=sqlserver;Database=ombor;User Id=sa;Password=ChangeMe_Strong#Passw0rd;TrustServerCertificate=True
JwtSettings__Key=replace-with-a-fresh-random-key-at-least-32-chars
SmsSettings__Token=your-eskiz-api-token
Sentry__Dsn=https://examplePublicKey@o0.ingest.sentry.io/0
MSSQL_SA_PASSWORD=ChangeMe_Strong#Passw0rd
# Optional — seeded owner login password (defaults to "Password123!" if omitted).
DataSeedSettings__SeedUserPassword=ChangeMe_Strong#Passw0rd

# ---- Non-secret config (GitHub Environment variables) ----
# Host folder bind-mounted over the container uploads dir; create it on the server first.
UPLOADS_HOST_PATH=/opt/ombor/dev/uploads

# CORS: one indexed key per allowed origin (add __1, __2, ... as needed).
Cors__AllowedOrigins__0=https://hisobot-uz.netlify.app

# Auth cookie (shared across subdomains in prod-like setups).
CookieSettings__Domain=.miraziz.net
CookieSettings__Secure=true
CookieSettings__SameSite=None

# JWT issuer/audience/lifetimes (the signing Key is a secret, above).
JwtSettings__Issuer=Ombor.API
JwtSettings__Audience=Ombor.Client
JwtSettings__AccessTokenExpiresInHours=1
JwtSettings__RefreshTokenExpiresInDays=30

# SMS gateway (the Token is a secret, above).
SmsSettings__ApiUrl=https://notify.eskiz.uz/api/message/sms/send
SmsSettings__FromNumber=4546

# Seed data knobs. NumberOf* are [Range(1, ...)] with no default — the app fails to start
# if any are missing or < 1 (DataSeedSettings is validated on startup).
DataSeedSettings__Locale=ru
DataSeedSettings__NumberOfOrganizations=3
DataSeedSettings__NumberOfCategories=20
DataSeedSettings__NumberOfProducts=200
DataSeedSettings__NumberOfMaxImagesPerProduct=10
DataSeedSettings__NumberOfPartners=50
DataSeedSettings__NumberOfTemplatesPerPartner=5
DataSeedSettings__NumberOfItemsPerTemplate=10
DataSeedSettings__NumberOfEmployees=10
DataSeedSettings__NumberOfWarehouses=5
DataSeedSettings__NumberOfItemsPerWarehouse=15
DataSeedSettings__NumberOfMaxTransactionsPerPartner=5
DataSeedSettings__NumberOfOrdersPerCustomer=5
