# Reference for the .env that docker-compose.deploy.yml consumes.
#
# On a real deploy this file is GENERATED by CI from the target GitHub Environment's secrets
# (+ the UPLOADS_HOST_PATH variable) and written to $DEPLOY_DIR/.env on the server — do not
# hand-edit the server. Copy to `.env` only for local/manual runs; the real .env is gitignored.
#
# Config split:
#   - Environment-invariant NON-SECRET config (cookies, JWT issuer/audience/expiry,
#     SMS ApiUrl/FromNumber, DataSeedSettings) lives in committed appsettings.Production.json — NOT here.
#   - Injected at deploy time: true secrets + per-environment CORS origins + UPLOADS_HOST_PATH.
#   - DEPLOY_HOST/USER/SSH_KEY/DEPLOY_DIR live only in GitHub (deploy plumbing) — never in .env.
# ASPNETCORE_ENVIRONMENT is pinned to Production in docker-compose.deploy.yml.

# ---- Secrets (GitHub Environment secrets) ----
# Password inside the connection string must match MSSQL_SA_PASSWORD below.
ConnectionStrings__DefaultConnection=Server=sqlserver;Database=ombor;User Id=sa;Password=ChangeMe_Strong#Passw0rd;TrustServerCertificate=True
JwtSettings__Key=replace-with-a-fresh-random-key-at-least-32-chars
SmsSettings__Token=your-eskiz-api-token
Sentry__Dsn=https://examplePublicKey@o0.ingest.sentry.io/0
MSSQL_SA_PASSWORD=ChangeMe_Strong#Passw0rd
# Seeded owner login password (overrides the appsettings default).
DataSeedSettings__SeedUserPassword=ChangeMe_Strong#Passw0rd

# ---- Non-secret config (GitHub Environment variables) ----
# CORS: one indexed key per allowed origin (add __1, __2, ... as needed). Per-environment.
Cors__AllowedOrigins__0=https://hisobot-uz.netlify.app
# Host folder bind-mounted over the container uploads dir; create it on the server first.
UPLOADS_HOST_PATH=/opt/ombor/dev/uploads
