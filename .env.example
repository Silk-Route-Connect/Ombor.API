# Copy to `.env` on the deploy server (same directory as docker-compose.deploy.yml) and fill in.
# The real .env holds secrets and is gitignored — never commit it.

# SQL Server SA password. Must satisfy SQL Server's strong-password policy.
MSSQL_SA_PASSWORD=ChangeMe_Strong#Passw0rd

# API connection string. Host is the compose service name `sqlserver` on the shared network.
ConnectionStrings__DefaultConnection=Server=sqlserver;Database=ombor;User Id=sa;Password=ChangeMe_Strong#Passw0rd;TrustServerCertificate=True

# Dev environment selects the development seeder and dev appsettings.
ASPNETCORE_ENVIRONMENT=Development

# Host directory bind-mounted over the container's uploads folder. Create it on the server first.
UPLOADS_HOST_PATH=/opt/ombor/dev/uploads

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). Maps api.miraziz.net to the API.
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
